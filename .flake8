[flake8]
# Maximum line length (match black)
max-line-length = 100

# Ignore specific errors
ignore =
    E203,  # Whitespace before ':' (conflicts with black)
    E501,  # Line too long (handled by black)
    W503,  # Line break before binary operator (conflicts with black)
    E266,  # Too many leading '#' for block comment
    E402,  # Module level import not at top (needed for sys.path hacks)
    F401,  # Imported but unused (some imports are for re-export)
    W504,  # Line break after binary operator

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    BuildTools,
    plugins/marketplace,
    tests/fixtures

# Maximum complexity
max-complexity = 15

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811,F841

# Show source code for each error
show-source = True

# Show the relevant text for each error
show-pep8 = True

# Count errors
count = True

# Enable PyFlakes checks
enable-extensions =

# Statistics
statistics = True
